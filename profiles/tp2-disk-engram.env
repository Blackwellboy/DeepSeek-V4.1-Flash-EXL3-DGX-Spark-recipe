# EXPERIMENTAL: TP2 disk-backed Engram qualification.
# Build with: bash scripts/build_disk_engram_runtime.sh
IMAGE=deepseek-v41-exl3:disk-engram
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=1024
TEXT_ONLY=1
DSPARK=0
EAGER=1
NATIVE_MOE=0
MOE_PARALLEL_MODE=ep
VLLM_ENGRAM_DISK_BACKED=1
VLLM_EXL3_TRELLIS_ARENA=1
VLLM_EXL3_ARENA_PRESCAN=1
# Required per deployment: exact materialized checkpoint path inside both containers.
# MODEL=/models/DSV4.1-Flash-SAGE-EXL3-TP2
# VLLM_ENGRAM_MODEL_DIR=/models/DSV4.1-Flash-SAGE-EXL3-TP2
EXTRA_VLLM_ARGS='--engram-config {"cpu_offload":false,"disk_backed":true}'
