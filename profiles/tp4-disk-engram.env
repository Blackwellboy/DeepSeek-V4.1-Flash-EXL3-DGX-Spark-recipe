# EXPERIMENTAL: TP4 disk-backed Engram qualification (not baseline).
# Requires a runtime/image overlay that implements EngramConfig.disk_backed
# (see overlays/disk-engram/). Do not treat this profile as the default serve path.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=1024
TEXT_ONLY=1
DSPARK=0
EAGER=1
NATIVE_MOE=0
VLLM_ENGRAM_DISK_BACKED=1
# Optional: node-local checkpoint mount inside the container (override as needed).
# VLLM_ENGRAM_MODEL_DIR=/models
# Pass structured Engram config on the vLLM CLI (shell-split EXTRA_VLLM_ARGS).
EXTRA_VLLM_ARGS='--engram-config {"cpu_offload":false,"disk_backed":true}'
