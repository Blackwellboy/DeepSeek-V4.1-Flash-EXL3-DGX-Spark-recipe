# Shared runtime image and cluster settings
IMAGE=deepseek-v41-exl3:spark
CONTAINER_NAME=dsv41-exl3
RAY_PORT=6379

# Required: Hugging Face repo id or path visible inside every container.
# For a local checkpoint, set MODEL_DIR on every node and use MODEL=/models/<dir>.
MODEL=
MODEL_REVISION=
MODEL_DIR=
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
HF_TOKEN=
SERVED_MODEL_NAME=deepseek-v41-exl3

# Conservative first-boot settings
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=0
EAGER=1

# Leave blank to use topology defaults: TP4 -> 0, TP2 -> 1.
NATIVE_MOE=

# API
HOST=0.0.0.0
PORT=8000
