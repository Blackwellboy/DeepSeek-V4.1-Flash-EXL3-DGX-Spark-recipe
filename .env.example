# Shared runtime image and cluster settings
IMAGE=deepseek-v41-exl3:spark
CONTAINER_NAME=dsv41-exl3
RAY_PORT=6379

# CUDA extension build target. DGX Spark / GB10 uses 12.1a.
# For an sm_120 CUDA 12.8 host, such as RTX 50 / RTX PRO Blackwell,
# use TORCH_CUDA_ARCH_LIST=12.0 when the installed toolchain reports sm_120.
TORCH_CUDA_ARCH_LIST=12.1a

# Published topology-specific checkpoints on Hugging Face.
# TP2 is currently a recovery/source artifact until a layer-uniform-K repack is published.
MODEL_TP4=vcruz305/DSV4.1-Flash-EXL3-4.75bpw
MODEL_TP2=vcruz305/DSV4.1-Flash-SAGE-EXL3-3.30bpw

# Optional global override. Leave blank to let TP4/TP2 select MODEL_TP4/MODEL_TP2.
# For a local checkpoint, set MODEL_DIR on every node and use MODEL=/models/<dir>.
MODEL=
MODEL_REVISION=
MODEL_DIR=
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
HF_TOKEN=
SERVED_MODEL_NAME=deepseek-v41-exl3

# Conservative first-boot settings for GB10 unified memory.
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=0
EAGER=1

# Correctness-first default for both TP2 and TP4 is ExLlamaV3 (NATIVE_MOE=0).
# Set NATIVE_MOE=1 only for an explicit custom p2b K2-K4 A/B after baseline parity.
NATIVE_MOE=0

# Set to 1 to print the exact vLLM command and exit before model load.
DRY_RUN=0

# API
HOST=0.0.0.0
PORT=8000
