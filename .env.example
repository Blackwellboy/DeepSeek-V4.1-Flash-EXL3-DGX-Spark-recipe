# Shared runtime image and cluster settings
IMAGE=deepseek-v41-exl3:spark
CONTAINER_NAME=dsv41-exl3
RAY_PORT=6379

# CUDA extension build target. DGX Spark / GB10 uses 12.1a.
# For an sm_120 CUDA 12.8 host, such as RTX 50 / RTX PRO Blackwell,
# use TORCH_CUDA_ARCH_LIST=12.0 when the installed toolchain reports sm_120.
TORCH_CUDA_ARCH_LIST=12.1a

# Default public EXL3 checkpoint on Hugging Face.
# Override MODEL for a local path or alternate TP2/TP4 checkpoint.
MODEL=vcruz305/DSV4.1-Flash-EXL3
MODEL_REVISION=
MODEL_DIR=
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
HF_TOKEN=
SERVED_MODEL_NAME=deepseek-v41-exl3

# Conservative first-boot settings for GB10 unified memory.
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=0
EAGER=1

# Leave blank to use topology defaults: TP4 -> 0, TP2 -> 1.
NATIVE_MOE=

# API
HOST=0.0.0.0
PORT=8000
